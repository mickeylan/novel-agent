# Server Configuration
API_HOST=127.0.0.1
API_PORT=8080

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=novel_agent
DB_USER=novel_agent
DB_PASSWORD=change-me

# LLM Configuration
# Supported providers: modelscope, openai, ollama, sglang, llama
LLM_PROVIDER=modelscope
LLM_MODEL=qwen3.5-plus
LLM_API_KEY_FILE=../secrets/modelscope.key
# 通用覆盖，也可使用下方与 Provider 匹配的专用变量
# LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
MODELSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# SGLANG_BASE_URL=http://127.0.0.1:30000
# LLAMA_BASE_URL=http://10.0.0.200:8080

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://10.0.0.200:8081
EMBEDDING_MODEL=bge-m3-Q4_K_M.gguf
EMBEDDING_DIMENSION=1024

# Config path (when starting from backend/)
CONFIG_PATH=config.yaml
